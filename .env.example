# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# Database Configuration
# Default to SQLite for local development; can be changed to PostgreSQL in production
DATABASE_URL=sqlite:///./autonomous_agent.db

# LLM & Embeddings Configuration (Supports Groq / xAI / OpenAI OpenAI-compatible APIs)
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Legacy OpenAI Fallback Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
